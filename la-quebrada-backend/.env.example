# Copiá este archivo como .env y completá los valores reales. El .env nunca va al repo.

# Conexión a Neon (la "pooled" sirve para el servidor; para pg_dump usá la directa, sin "-pooler")
DATABASE_URL="postgresql://usuario:password@host/dbname?sslmode=require&channel_binding=require"
PORT=3000

# Firma de los tokens de sesión: un texto largo y aleatorio. Si cambia, todas las sesiones se cierran.
JWT_SECRET="cambiar-por-un-texto-largo-y-aleatorio"

# Orígenes que pueden usar la API del sistema, separados por coma (la API pública de la landing acepta cualquiera)
CORS_ORIGENES="http://localhost:4200"

# Cuenta de Gmail para los recordatorios de pago (usar una "contraseña de aplicación", no la normal)
GMAIL_USER="cuenta@gmail.com"
GMAIL_APP_PASSWORD="xxxx xxxx xxxx xxxx"
